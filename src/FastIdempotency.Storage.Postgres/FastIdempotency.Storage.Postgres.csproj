<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FastIdempotency.Storage.Postgres</PackageId>
    <Description>PostgreSQL storage provider with row-level distributed locking and transactions for FastIdempotency.</Description>
    <PackageTags>idempotency;postgresql;npgsql;distributed-lock;fastidempotency</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastIdempotency.Core\FastIdempotency.Core.csproj" />
  </ItemGroup>

</Project>
