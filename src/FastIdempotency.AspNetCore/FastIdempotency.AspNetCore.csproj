<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FastIdempotency.AspNetCore</PackageId>
    <Description>High-performance distributed idempotency middleware for ASP.NET Core with sub-millisecond execution and SIMD payload verification.</Description>
    <PackageTags>idempotency;aspnetcore;middleware;fastidempotency;distributed-lock;performance</PackageTags>
  </PropertyGroup>

  <!-- Use the web SDK framework reference so ASP.NET Core + DI + Logging are all available -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastIdempotency.Core\FastIdempotency.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FastIdempotency.Tests" />
    <InternalsVisibleTo Include="FastIdempotency.Benchmarks" />
  </ItemGroup>

</Project>
