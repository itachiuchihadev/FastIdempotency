<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FastIdempotency.Storage.Redis</PackageId>
    <Description>Redis distributed storage provider with atomic Lua script locking and pipelined response storage for FastIdempotency.</Description>
    <PackageTags>idempotency;redis;stackexchange-redis;distributed-lock;fastidempotency</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="3.1.31" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed Lua scripts into the assembly for atomic Redis operations -->
    <EmbeddedResource Include="Scripts\acquire_lock.lua" />
    <EmbeddedResource Include="Scripts\release_lock.lua" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastIdempotency.Core\FastIdempotency.Core.csproj" />
  </ItemGroup>

</Project>
