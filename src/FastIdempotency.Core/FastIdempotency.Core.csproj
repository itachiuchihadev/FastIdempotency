<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FastIdempotency.Core</PackageId>
    <Description>Core contracts, models, and SIMD-accelerated XxHash3 request hasher for FastIdempotency.</Description>
    <PackageTags>idempotency;fastidempotency;xxhash3;performance;distributed-systems;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.11" />
  </ItemGroup>

</Project>
